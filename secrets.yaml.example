# Copy to secrets.yaml (git-ignored) and fill in.
# NOTE: there are NO data-source tokens here. Both Jolpica and OpenF1 are used
# on their free, unauthenticated tiers (REQUIREMENTS.md decision 65).
wifi_ssid: "your-ssid"
wifi_password: "your-password"

# Generate with: openssl rand -base64 32
api_encryption_key: "REPLACE_ME"

# web_server auth (7.1): the page controls every setting, so do not leave it open
web_username: "f1"
web_password: "REPLACE_ME"
